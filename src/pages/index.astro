---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Indoor Growing Equipment Guides"
  description="Buying guides and comparisons for indoor and controlled-environment growing equipment."
>
  <h1 class="text-3xl font-bold mb-2">Indoor Growing Equipment Guides</h1>
  <p class="text-slate-600 mb-10">
    Buying guides and honest comparisons for tents, lighting, climate control,
    and nutrients for controlled-environment growing.
  </p>

  <ul class="space-y-8">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`} class="text-xl font-semibold hover:underline">
          {post.data.title}
        </a>
        <p class="text-slate-600 mt-1">{post.data.description}</p>
        <p class="text-sm text-slate-400 mt-1">
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
      </li>
    ))}
  </ul>

  {posts.length === 0 && (
    <p class="text-slate-500">No posts yet — add MDX files to src/content/posts/.</p>
  )}
</Layout>
